{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "id -> shell command that must exit 0 for the goal to count as done"
    },
    "checklist": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "doing",
              "done",
              "blocked",
              "skipped"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "done_when": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    },
    "blockers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "unknown"
        ]
      }
    },
    "current": {
      "type": "string"
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "user_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "goal",
    "checks",
    "checklist"
  ],
  "additionalProperties": true,
  "x-stepbook": {
    "protected": [
      "goal",
      "constraints",
      "checks",
      "user_requirements"
    ],
    "max_deletions": 8
  }
}
